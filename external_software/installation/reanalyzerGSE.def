Bootstrap: docker
From: ubuntu:24.04

%post
    # --------------------------------------------------------------------------
    # 1. System Setup & Dependencies
    # --------------------------------------------------------------------------
    export DEBIAN_FRONTEND=noninteractive
    export LC_ALL=en_US.UTF-8
    export LANG=en_US.UTF-8
    export APPTAINER_CACHEDIR=$APPTAINER_TMPDIR/cache
    export TMPDIR=$APPTAINER_TMPDIR/build
    mkdir -p $APPTAINER_TMPDIR/cache; mkdir -p $APPTAINER_TMPDIR/build
    rm -rf $APPTAINER_TMPDIR/cache/*; rm -rf $APPTAINER_TMPDIR/build/*
    

    # Update and Install Dependencies
    apt-get update -qq && \
    apt-get install -qy --no-install-recommends \
      wget curl ca-certificates gnupg2 dirmngr locales \
      software-properties-common procps git git-all build-essential \
      gcc g++ gfortran make cmake bc \
      libcurl4-openssl-dev libssl-dev libxml2-dev libxml2 zlib1g-dev \
      libfontconfig1-dev libharfbuzz-dev libfribidi-dev \
      libfreetype6-dev libpng-dev libpng-tools libpng16-16 libtiff-dev libtiff5-dev libjpeg-dev \
      libmagick++-dev libmagickwand-dev libmagickcore-dev imagemagick libglu1-mesa-dev texlive \
      libopenblas-dev liblapack-dev libcairo2-dev libncurses5-dev libgit2-dev \
      libbz2-dev liblzma-dev libtbb12 libdeflate0 libdeflate-dev libisal2 libisal-dev \
      libhdf5-dev libgl1-mesa-dev libglu1-mesa libnode-dev gsfonts libglpk-dev \
      python3-dev python3-pip python3-venv python3-setuptools python-is-python3 picard-tools \
      cython3 libpoppler-cpp-dev poppler-data \
      fastqc pigz parallel zip unzip bzip2 expat file jq \
      default-jre-headless \
    && locale-gen en_US.UTF-8 \
    && update-locale LANG=en_US.UTF-8


    # Link picard-tools to picard if installed via apt
    ln -sf /usr/bin/picard-tools /usr/bin/picard || true
    # --------------------------------------------------------------------------
    mkdir -p /bin_external/lib
    cd $TMPDIR && rm -rf *

    # SRAToolkit
    curl -fsSL --retry 10 https://ftp-trace.ncbi.nlm.nih.gov/sra/sdk/current/sratoolkit.current-ubuntu64.tar.gz -o sratoolkit.tar.gz
    tar xzf sratoolkit.tar.gz
    find sratoolkit*/bin -type f -exec mv {} /bin_external/ \;
    
    # Samtools
    curl -fsSL --retry 10 https://github.com/samtools/samtools/releases/download/1.23/samtools-1.23.tar.bz2 -o samtools.tar.bz2
    tar xf samtools.tar.bz2 && cd samtools-1.23
    ./configure -q --without-curses --prefix=$PWD/bin && make -s && make -s install
    mv bin/bin/* /bin_external/
    cd $TMPDIR

    # Edirect
    yes n | sh -c "$(curl -fsSL --retry 10 https://ftp.ncbi.nlm.nih.gov/entrez/entrezdirect/install-edirect.sh)"
    mv /root/edirect /bin_external/edirect
    
    # Fastp
    curl -fsSL --retry 10 http://opengene.org/fastp/fastp -o fastp && chmod a+x ./fastp && mv ./fastp /bin_external/
    
    # Taxonkit
    curl -fsSL --retry 10 https://github.com/shenwei356/taxonkit/releases/download/v0.20.0/taxonkit_linux_amd64.tar.gz -o taxonkit.tar.gz
    tar xzf taxonkit.tar.gz && mv taxonkit /bin_external/
    
    # Sortmerna
    curl -fsSL --retry 10 https://github.com/sortmerna/sortmerna/releases/download/v4.3.7/sortmerna-4.3.7-Linux.tar.gz -o sortmerna.tar.gz
    tar xzf sortmerna.tar.gz && mv sortmerna*/bin/* /bin_external/
    
    # Salmon
    curl -fsSL --retry 10 https://github.com/COMBINE-lab/salmon/releases/download/v1.10.0/salmon-1.10.0_linux_x86_64.tar.gz -o salmon.tar.gz
    tar xzf salmon.tar.gz && mv salmon*/bin/* /bin_external/
    
    # Kallisto
    curl -fsSL --retry 10 https://github.com/pachterlab/kallisto/releases/download/v0.51.1/kallisto_linux-v0.51.1.tar.gz -o kallisto.tar.gz
    tar xzf kallisto.tar.gz && mv kallisto/kallisto /bin_external/
    
    # STAR
    curl -fsSL --retry 10 https://github.com/alexdobin/STAR/releases/download/2.7.11b/STAR_2.7.11b.zip -o STAR.zip
    unzip -qqo STAR.zip && mv STAR*/Linux_x86_64_static/* /bin_external/
    
    # Subread
    curl -fsSL --retry 10 https://sourceforge.net/projects/subread/files/subread-2.1.1/subread-2.1.1-Linux-x86_64.tar.gz/download -o subread.tar.gz
    tar -xzf subread.tar.gz && mv subread*/bin/* /bin_external/
    
    # Qualimap
    curl -fsSL --retry 10 https://bitbucket.org/kokonech/qualimap/downloads/qualimap_v2.3.zip -o qualimap.zip
    unzip -qqo qualimap.zip
    sed -i 's/-XX:MaxPermSize/-XX:MaxMetaspaceSize/g' qualimap_v2.3/qualimap
    mv qualimap_v2.3/qualimap /bin_external/
    mv qualimap_v2.3/qualimap.jar /bin_external/
    mv qualimap_v2.3/lib/* /bin_external/lib/

    # Compiling seqk and hisat2
    git clone -q https://github.com/lh3/seqtk.git && cd seqtk && make -s && mv seqtk /bin_external/ && cd ..
    git clone -q https://github.com/DaehwanKimLab/hisat2.git && cd hisat2 && make -s && mv hisat2* /bin_external/ && cd ..
    
    # Kraken2
    git clone -q https://github.com/DerrickWood/kraken2
    mkdir -p kraken2/bin
    ./kraken2/install_kraken2.sh $PWD/kraken2/bin
    mv kraken2/bin/* /bin_external/
    git clone -q https://github.com/jenniferlu717/KrakenTools
    chmod +x KrakenTools/* && mv KrakenTools/* /bin_external/

    # Bowtie2
    curl -fsSL --retry 10 https://github.com/BenLangmead/bowtie2/releases/download/v2.5.5/bowtie2-2.5.5-linux-x86_64.zip -o bowtie2.zip
    unzip -qqo bowtie2.zip && mv bowtie2*/bowtie* /bin_external/

    # --------------------------------------------------------------------------
    # 3. Python Environment (Python 3.12)
    # --------------------------------------------------------------------------
    
    cat <<EOF > $APPTAINER_TMPDIR/requirements.txt
numpy==2.3.5
pandas==2.3.3
scipy==1.17.0
matplotlib==3.10.8
networkx==3.6.1
statsmodels==0.14.6
sympy==1.14.0
biopython==1.84
pysam==0.23.3
deepTools==3.5.6
multiqc==1.33
fastq-dl==4.0.1
pysradb==2.5.1
RSeQC==5.0.4
netZooPy==0.10.8
openpyxl==3.1.5
python-igraph==1.0.0
rich==13.9.4
tqdm==4.67.3
pyyaml==6.0.3
yq==3.4.3
jq==1.11.0
plotly==6.5.2
kaleido==0.2.1
click==8.3.1
recentrifuge==2.1.1
markdown==3.10.2
markupsafe==3.0.3
pypdf
EOF

    # Ubuntu 24.04 enforces PEP 668. We use --break-system-packages
    # because we are modifying the container's system python intentionally.
   
    apt-get remove -qy python3-numpy python3-scipy python3-matplotlib python3-pandas 2>/dev/null || true
    pip3 install --no-cache-dir --break-system-packages torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cpu
    pip3 install --no-cache-dir --break-system-packages --ignore-installed -r $APPTAINER_TMPDIR/requirements.txt

    # --------------------------------------------------------------------------
    # 4. R Packages (Ubuntu 24.04 / Noble)
    # --------------------------------------------------------------------------
    # Installing R, pinned to 4.6.1 (the cran40 repo retains old versions, so this
    # exact-version pin is reproducible and won't drift when R 4.6.2/4.7 are released)
    wget -qO- https://cloud.r-project.org/bin/linux/ubuntu/marutter_pubkey.asc | tee -a /etc/apt/trusted.gpg.d/cran_ubuntu_key.asc
    add-apt-repository -y "deb https://cloud.r-project.org/bin/linux/ubuntu $(lsb_release -cs)-cran40/"
    apt-get update -qq && apt-get install -qy --no-install-recommends \
      r-base-core=4.6.1-1.2404.1 r-base-dev=4.6.1-1.2404.1 r-base=4.6.1-1.2404.1 pandoc
    
    cat <<EOF > $APPTAINER_TMPDIR/install_r.R
install.packages("pak", quiet = T)
library(pak); options(pak.timeout = 1200); pak_cleanup(force = TRUE)

pkgs <- c(
  "abind", "annotate", "AnnotationDbi", "AnnotationFilter", "AnnotationHub", "ape", "aplot", "arules", "askpass", "ASpli", 
  "assorthead", "backports", "base64enc", "beachmat", "BH", "Biobase", "BiocBaseUtils", "BiocFileCache", "BiocGenerics", "BiocIO", 
  "BiocManager", "BiocParallel", "BiocSingular", "BiocStyle", "BiocVersion", "biomaRt", "Biostrings", "biovizBase", "bit", "bit64", 
  "bitops", "blob", "bookdown", "brew", "brio", "broom", "BSgenome", "bslib", "cachem", "callr", 
  "car", "carData", "caTools", "cellranger", "checkmate", "chron", "cigarillo", "circlize", "cli", "clipr", 
  "clue", "clusterProfiler", "colorspace", "commonmark", "ComplexHeatmap", "confintr", "conflicted", "corpcor", "corrplot", "cowplot", 
  "cpp11", "crayon", "credentials", "crosstalk", "curl", "data.table", "DBI", "dbplyr", "DelayedArray", "deldir", 
  "dendextend", "DEoptimR", "Deriv", "desc", "DESeq2", "devtools", "DEXSeq", "dichromat", "diffobj", "digest", 
  "dir.expiry", "dirmult", "doBy", "doParallel", "doSNOW", "DOSE", "dotCall64", "downlit", "dplyr", "dqrng", "DT", 
  "dtplyr", "dynamicTreeCut", "DynDoc", "e1071", "edgeR", "ellipse", "ellipsis", "emmeans", "EnhancedVolcano", "enrichplot", "enrichR",
  "ensembldb", "estimability", "europepmc", "evaluate", "expm", "FactoMineR", "fansi", "farver", "fastcluster", "fastDummies", "fastmap", 
  "fastmatch", "fgsea", "filelock", "fitdistrplus", "flashClust", "FNN", "fontawesome", "fontBitstreamVera", "fontLiberation", "fontquiver", 
  "forcats", "foreach", "forecast", "formatR", "Formula", "fracdiff", "fs", "futile.logger", "futile.options", "future", 
  "future.apply", "gargle", "gdtools", "genefilter", "geneplotter", "generics", "GenomeInfoDb", "GenomeInfoDbData", "GenomicAlignments", "GenomicFeatures", 
  "GenomicRanges", "GEOquery", "gert", "GetoptLong", "ggdendro", "ggforce", "ggfortify", "ggfun", "ggiraph", "ggnewscale", 
  "ggplot2", "ggplotify", "ggarchery", "ggpmisc", "ggpp", "ggpubr", "ggraph", "ggrepel", "ggridges", "ggsci", "ggsignif", 
  "ggtangle", "ggtree", "ggupset", "gh", "gitcreds", "GlobalOptions", "globals", "glue", "GO.db", "gontr", "goftest", "googledrive",
  "googlesheets4", "GOSemSim", "gplots", "graph", "graphite", "graphlayouts", "gridExtra", "gridGraphics", "GSEABase", "gson", 
  "GSVA", "gtable", "gtools", "gsubfn", "Gviz", "h5mread", "harmony", "hash", "haven", "HDF5Array", 
  "here", "hexbin", "highr", "Hmisc", "hms", "htmlTable", "htmltools", "htmlwidgets", "httpuv", "httr", 
  "httr2", "hwriter", "ica", "ids", "igraph", "igvShiny", "impute", "ini", "interp", "IRanges", 
  "irlba", "isoband", "IsoformSwitchAnalyzeR", "iterators", "jpeg", "jquerylib", "jsonlite", "KEGGgraph", "KEGGREST", "kernlab", 
  "knitr", "labeling", "lambda.r", "later", "latticeExtra", "lazyeval", "leaps", "lifecycle", "limma", "limSolve", 
  "listenv", "lme4", "lmodel2", "lmtest", "locfdr", "locfit", "lpSolve", "lsa", "lubridate", "magick", 
  "magrittr", "matrixcalc", "MatrixGenerics", "MatrixModels", "matrixStats", "MCL", "memoise", "memuse", "Mfuzz", "microbenchmark", "network", 
  "mime", "miniUI", "minpack.lm", "minqa", "mixtools", "modelr", "multcomp", "multcompView", "mvtnorm", "nloptr", 
  "NormqPCR", "numDeriv", "openssl", "org.Hs.eg.db", "org.Mm.eg.db", "otel", "pandoc", "parallelly", "patchwork", "pathview", 
  "pbapply", "pbkrtest", "pbmcapply", "pdftools", "pfamAnalyzeR", "pillar", "pkgbuild", "pkgconfig", "pkgdown", "pkgload", 
  "plotly", "plotrix", "plyr", "png", "polyclip", "polynom", "praise", "preprocessCore", "prettyunits", "processx", 
  "profvis", "progress", "progressr", "promises", "proto", "ProtGenerics", "proxy", "PRROC", "ps", "purrr", 
  "pwalign", "qpdf", "qpcR", "qs2", "quadprog", "quantreg", "qvalue", "R.methodsS3", "R.oo", "R.utils", 
  "R6", "ragg", "randomcoloR", "RANN", "rappdirs", "rbibutils", "rcmdcheck", "RColorBrewer", "RcppAnnoy", "RcppArmadillo", 
  "RcppEigen", "RcppHNSW", "RcppParallel", "RcppProgress", "RcppTOML", "RCurl", "Rdpack", "readr", "ReadqPCR", "readxl", 
  "ReactomePA", "reactome.db", "reformulas", "rematch", "rematch2", "remotes", "rentrez", "reprex", "reshape2", "restfulr", 
  "reticulate", "rgl", "Rgraphviz", "rhdf5", "rhdf5filters", "Rhdf5lib", "RhpcBLASctl", "Rhtslib", "rjson", "rlang", 
  "rmarkdown", "robustbase", "ROCR", "roxygen2", "rprojroot", "Rsamtools", "RSpectra", "RSQLite", "rstatix", "rstudioapi", 
  "rsvd", "Rtsne", "rtracklayer", "rversions", "rvest", "S4Arrays", "sandwich", "saseR", "sass", "satuRn", 
  "ScaledMatrix", "scales", "scattermore", "scatterpie", "scatterplot3d", "sctransform", "segmented", "selectr", "Seqinfo", "sessioninfo", 
  "Seurat", "SeuratObject", "shape", "shiny", "shinyjs", "SingleCellExperiment", "sitmo", "snow", "SnowballC", "sourcetools", 
  "sp", "spam", "SparseArray", "sparseMatrixStats", "SparseM", "SpatialExperiment", "spatstat.data", "spatstat.explore", "spatstat.geom", "spatstat.random", 
  "spatstat.sparse", "spatstat.univar", "spatstat.utils", "splus2R", "sqldf", "statmod", "STRINGdb", "stringfish", "stringi", "stringr", 
  "SummarizedExperiment", "sva", "sys", "systemfonts", "tensor", "testthat", "textshape", "textshaping", "TH.data", "tibble", "tidydr", 
  "tidygraph", "tidyr", "tidyselect", "tidytree", "tidyverse", "timechange", "timeDate", "tinytex", "tkWidgets", "treeio", 
  "tweenr", "txdbmaker", "tximeta", "tximport", "tzdb", "UCSC.utils", "umap", "UpSetR", "urca", "urlchecker", 
  "usethis", "utf8", "uuid", "uwot", "V8", "VariantAnnotation", "vctrs", "VennDiagram", "viridis", "viridisLite", 
  "vroom", "waldo", "WGCNA", "whisker", "widgetTools", "withr", "writexl", "xfun", "XML", "xml2", 
  "xopen", "xtable", "xts", "XVector", "yaml", "yulab.utils", "zip", "zoo"
)

# Function to install and properly handle dependencies
install_pkgs_batched <- function(pkgs) {
  cat("Analyzing dependencies...\n")
  
  # Get dependency info
  raw_deps <- pak::pkg_deps(pkgs, upgrade = FALSE)
  
  # Force to plain data.frame, preserve list-columns
  deps_info <- as.data.frame(raw_deps, stringsAsFactors = FALSE)
  n_rows <- as.integer(nrow(deps_info))
  cat(sprintf("deps_info has %d rows\n", n_rows))
  
  # Extract scalar columns directly from raw tibble
  deps_info[["ref"]]     <- as.character(raw_deps[["ref"]])
  deps_info[["package"]] <- as.character(raw_deps[["package"]])
  deps_info[["version"]] <- as.character(raw_deps[["version"]])
  
  # Sanitize: if package looks like "pkg@version", fix it
  bad_pkg <- grepl("@", deps_info[["package"]])
  if (any(bad_pkg)) {
    deps_info[["package"]][bad_pkg] <- sub("@.*$", "", deps_info[["ref"]][bad_pkg])
  }
  
  # Sanitize: if version looks like "pkg@version" or equals package name, fix it
  bad_ver <- deps_info[["version"]] == deps_info[["package"]] |
             deps_info[["version"]] == deps_info[["ref"]]     |
             grepl("@", deps_info[["version"]])
  if (any(bad_ver)) {
    deps_info[["version"]][bad_ver] <- ifelse(
      grepl("@", deps_info[["ref"]][bad_ver]),
      sub("^[^@]+@", "", deps_info[["ref"]][bad_ver]),
      NA_character_
    )
  }
  
  # Preserve the deps list-column from raw
  deps_info[["deps"]] <- raw_deps[["deps"]]
  
  cat("Sample of deps_info:\n")
  print(data.frame(
    ref     = head(deps_info[["ref"]], 8),
    package = head(deps_info[["package"]], 8),
    version = head(deps_info[["version"]], 8),
    stringsAsFactors = FALSE
  ))
  
  get_dep_df <- function(idx) {
    if (idx < 1 || idx > length(deps_info[["deps"]])) return(NULL)
    df <- deps_info[["deps"]][[idx]]
    if (is.data.frame(df) && nrow(df) > 0) return(df)
    return(NULL)
  }
  
  is_dep_type <- function(type_vec) {
    tolower(as.character(type_vec)) %in% c("imports", "depends", "linkingto")
  }
  
  make_pkg_string <- function(p) {
    row_idx <- match(p, deps_info[["package"]])
    if (is.na(row_idx)) return(as.character(p))
    ref <- deps_info[["ref"]][row_idx]
    ver <- deps_info[["version"]][row_idx]
    if (!is.na(ref) && grepl("@", ref) && !grepl("@NA$", ref)) {
      return(as.character(ref))
    }
    if (!is.na(ver) && ver != "" && ver != p && ver != "NA") {
      return(paste0(p, "@", ver))
    }
    return(as.character(p))
  }
  
  # Identify extra deps
  all_dep_pkgs <- unique(unlist(lapply(seq_len(n_rows), function(i) {
    dep_df <- get_dep_df(i)
    if (is.null(dep_df)) return(NULL)
    pkgs_in_dep  <- as.character(dep_df[["package"]])
    types_in_dep <- as.character(dep_df[["type"]])
    pkgs_in_dep[is_dep_type(types_in_dep)]
  }), use.names = FALSE))
  
  extra_pkgs <- setdiff(all_dep_pkgs, deps_info[["package"]])
  extra_pkgs <- extra_pkgs[!is.na(extra_pkgs)]
  extra_pkgs <- extra_pkgs[extra_pkgs != "R"]
  extra_pkgs <- extra_pkgs[!extra_pkgs %in% rownames(installed.packages())]
  
  if (length(extra_pkgs) > 0) {
    if (length(extra_pkgs) > 100) {
      cat(sprintf("Warning: %d extra deps found, capping at 100\n", length(extra_pkgs)))
      extra_pkgs <- head(extra_pkgs, 100)
    }
    cat(sprintf("Found %d additional dependency packages, fetching metadata...\n",
                length(extra_pkgs)))
    tryCatch({
      raw_extra <- pak::pkg_deps(extra_pkgs, upgrade = FALSE)
      extra_deps <- as.data.frame(raw_extra, stringsAsFactors = FALSE)
      extra_deps[["ref"]]     <- as.character(raw_extra[["ref"]])
      extra_deps[["package"]] <- as.character(raw_extra[["package"]])
      extra_deps[["version"]] <- as.character(raw_extra[["version"]])
      extra_deps[["deps"]]    <- raw_extra[["deps"]]
      bad_p <- grepl("@", extra_deps[["package"]])
      if (any(bad_p)) {
        extra_deps[["package"]][bad_p] <- sub("@.*$", "", extra_deps[["ref"]][bad_p])
      }
      bad_v <- extra_deps[["version"]] == extra_deps[["ref"]] |
               grepl("@", extra_deps[["version"]])
      if (any(bad_v)) {
        extra_deps[["version"]][bad_v] <- ifelse(
          grepl("@", extra_deps[["ref"]][bad_v]),
          sub("^[^@]+@", "", extra_deps[["ref"]][bad_v]),
          NA_character_
        )
      }
      new_rows <- extra_deps[!extra_deps[["package"]] %in% deps_info[["package"]], ]
      if (nrow(new_rows) > 0) {
        deps_info <- rbind(deps_info, new_rows)
        n_rows <- as.integer(nrow(deps_info))
      }
    }, error = function(e) warning("Could not fetch extra deps: ", e$message))
  }
  
  all_pkgs <- unique(as.character(deps_info[["package"]]))
  all_pkgs <- all_pkgs[!is.na(all_pkgs)]
  
  check_version <- function(ver, op, required_ver) {
    if (is.null(op) || is.na(op) || op == "") return(TRUE)
    if (is.null(required_ver) || is.na(required_ver) || required_ver == "") return(TRUE)
    if (is.null(ver) || is.na(ver) || ver == "" || ver == "NA") return(FALSE)
    tryCatch({
      v1 <- package_version(as.character(ver))
      v2 <- package_version(as.character(required_ver))
      switch(op,
        ">="  = v1 >= v2,
        ">"   = v1 >  v2,
        "<="  = v1 <= v2,
        "<"   = v1 <  v2,
        "=="  = v1 == v2,
        "!="  = v1 != v2,
        TRUE)
    }, error = function(e) TRUE)
  }
  
  installed_snap <- as.data.frame(
    installed.packages()[, c("Package", "Version")],
    stringsAsFactors = FALSE
  )
  
  is_already_installed <- function(pkg, required_ver) {
    idx <- match(as.character(pkg), installed_snap[["Package"]])
    if (is.na(idx)) return(FALSE)
    check_version(installed_snap[["Version"]][idx], ">=", required_ver)
  }
  
  get_deps_in_list <- function(pkg, deps_info, pkg_list) {
    row_idx <- match(pkg, deps_info[["package"]])
    if (is.na(row_idx)) return(character(0))
    dep_df <- get_dep_df(row_idx)
    if (is.null(dep_df)) return(character(0))
    dep_pkgs  <- as.character(dep_df[["package"]])
    dep_types <- as.character(dep_df[["type"]])
    dep_ops   <- as.character(dep_df[["op"]])
    dep_vers  <- as.character(dep_df[["version"]])
    keep <- is_dep_type(dep_types) & dep_pkgs %in% pkg_list
    if (!any(keep)) return(character(0))
    dep_pkgs <- dep_pkgs[keep]
    dep_ops  <- dep_ops[keep]
    dep_vers <- dep_vers[keep]
    valid <- vapply(seq_along(dep_pkgs), function(i) {
      our_idx <- match(dep_pkgs[i], deps_info[["package"]])
      if (is.na(our_idx)) return(FALSE)
      check_version(deps_info[["version"]][our_idx], dep_ops[i], dep_vers[i])
    }, FUN.VALUE = logical(1))
    dep_pkgs[valid]
  }
  
  dep_map <- setNames(
    lapply(all_pkgs, get_deps_in_list, deps_info = deps_info, pkg_list = all_pkgs),
    all_pkgs
  )
  
  remaining <- all_pkgs
  theoretical_installed <- character(0)
  batches <- list()
  
  while (length(remaining) > 0) {
    ready <- remaining[vapply(remaining, function(p) {
      deps <- dep_map[[p]]
      length(deps) == 0 || all(deps %in% theoretical_installed)
    }, FUN.VALUE = logical(1))]
    if (length(ready) == 0) {
      warning("Circular dependency or unresolvable packages: ",
              paste(remaining, collapse = ", "))
      break
    }
    batches <- c(batches, list(ready))
    theoretical_installed <- c(theoretical_installed, ready)
    remaining <- setdiff(remaining, ready)
  }
  
  cat(sprintf("\nProcessing %d batches...\n", length(batches)))
  
  for (i in seq_along(batches)) {
    current_batch_raw <- batches[[i]]
    
    to_install_mask <- vapply(current_batch_raw, function(p) {
      row_idx <- match(p, deps_info[["package"]])
      req_ver <- deps_info[["version"]][row_idx]
      !is_already_installed(p, req_ver)
    }, FUN.VALUE = logical(1))
    
    pkgs_to_process <- current_batch_raw[to_install_mask]
    
    if (length(pkgs_to_process) == 0) {
      cat(sprintf("\n--- Batch %d / %d: All packages (%d) already satisfied ---\n",
                  i, length(batches),length(current_batch_raw)))
      next
    }
    
    final_pkgs <- vapply(pkgs_to_process, make_pkg_string, FUN.VALUE = character(1))
    final_pkgs <- unname(as.vector(final_pkgs))
    
    cat(sprintf("\n--- Batch %d / %d (%d packages) ---\n",
                i, length(batches), length(final_pkgs)))
    cat("Installing:", paste(final_pkgs, collapse = ", "), "\n")
    
    for (attempt in seq_len(10)) {
      success <- tryCatch({
        pak::pkg_install(final_pkgs, dependencies = FALSE, ask = FALSE)
        TRUE
      }, error = function(e) {
        cat(sprintf("  Attempt %d/10 failed: %s\n", attempt, e$message))
        if (attempt < 10) Sys.sleep(2)
        FALSE
      })
      if (success) break
    }
  }
  
  invisible(batches)
}

# Installation
install_pkgs_batched(pkgs); cat("\n\n\n\n\nBLOCK 1 R packages installed!\n\n\n\n\n")

pkg_install(c("url::https://cran.r-project.org/src/contrib/Archive/bayesbio/bayesbio_1.0.0.tar.gz",
	      "stephenturner/annotables@5bf7dc0"), dependencies = F, ask = FALSE)

pkg_install(c("url::https://cran.r-project.org/src/contrib/Archive/aPEAR/aPEAR_1.0.0.tar.gz",
              "url::https://cran.r-project.org/src/contrib/Archive/BisqueRNA/BisqueRNA_1.0.5.tar.gz",
              "url::https://cran.r-project.org/src/contrib/Archive/nVennR/nVennR_0.2.3.tar.gz"), dependencies = F, ask = FALSE)

# GOxploreR 1.2.8 declares importFrom(dplyr, id), but dplyr removed id() (deprecated
# 0.8.0, since defunct), so lazy-loading fails with "object 'id' is not exported by
# 'namespace:dplyr'". id() is never actually called in GOxploreR's code, so we drop the
# dead NAMESPACE import and install from the patched source.
local({
  url <- "https://cran.r-project.org/src/contrib/Archive/GOxploreR/GOxploreR_1.2.8.tar.gz"
  tgz <- tempfile(fileext = ".tar.gz")
  download.file(url, tgz, method = "libcurl", quiet = TRUE)
  exdir <- tempfile(); dir.create(exdir)
  untar(tgz, exdir = exdir)
  ns <- file.path(exdir, "GOxploreR", "NAMESPACE")
  L <- readLines(ns)
  drop <- gsub(" ", "", L) %in% c("importFrom(dplyr,id)", 'importFrom(dplyr,"id")')
  writeLines(L[!drop], ns)
  install.packages(file.path(exdir, "GOxploreR"), repos = NULL, type = "source")
})

# GOfuncR's src/unlock_environment.cc calls ENVFLAGS()/SET_ENVFLAGS(). R 4.6.1 stopped
# declaring them by default (moved behind the ENABLE_LEGACY_NONAPI switch), so the C++
# build fails with "'ENVFLAGS' was not declared in this scope" even though the symbols
# still exist in libR. Kept OUT of the batched install (a build failure there rolls back
# the entire pak transaction). We fetch the current Bioc source, re-enable the legacy API
# with a single #define, and install the patched package (pak resolves its deps).
local({
  repo <- BiocManager::repositories()[["BioCsoft"]]
  ver  <- available.packages(repos = repo)["GOfuncR", "Version"]
  url  <- sprintf("%s/GOfuncR_%s.tar.gz", contrib.url(repo, type = "source"), ver)
  tgz  <- tempfile(fileext = ".tar.gz")
  download.file(url, tgz, method = "libcurl", quiet = TRUE)
  exdir <- tempfile(); dir.create(exdir)
  untar(tgz, exdir = exdir)
  src <- file.path(exdir, "GOfuncR", "src", "unlock_environment.cc")
  writeLines(c("#define ENABLE_LEGACY_NONAPI", readLines(src)), src)
  pak::pkg_install(paste0("local::", file.path(exdir, "GOfuncR")), ask = FALSE)
})

cat("\n\n\n\n\nBLOCK 2 R packages installed!\n\n\n\n\n")

remotes::install_github("bnprks/BPCells/r", ref = "v0.3.1")

cat("\n\n\n\n\nBLOCK 3 R packages installed!\n\n\n\n\n")

# Extra packages: build deps + imguR + Bioc/CRAN packages used by
# microarray, deconvolution and enrichment paths
install_pkgs_batched(c("sparsesvd", "docopt","RcppThread","qlcMatrix"))

pkg_install("url::https://cran.r-project.org/src/contrib/Archive/imguR/imguR_1.0.3.tar.gz",dependencies=F, ask = F)

BiocManager::install(c(
  "affy",
  "funr",
  "scRecover",
  "msigdbr",
  "rrvgo",
  "openxlsx",
  "rbioapi",
  "org.Rn.eg.db"
), update = FALSE, ask = FALSE)

pak::pkg_install(c(
       "url::https://cran.r-project.org/src/contrib/Archive/preseqR/preseqR_4.0.0.tar.gz",
       "url::https://cran.r-project.org/src/contrib/Archive/CDSeq/CDSeq_1.0.8.tar.gz",
       "url::https://cran.r-project.org/src/contrib/Archive/autoGO/autoGO_1.0.1.tar.gz"), dependencies = FALSE, ask = FALSE)

cat("\n\n\n\n\nBLOCK 4 R packages installed!\n\n\n\n\n")

unlink(list.files(path = .libPaths(), pattern = "^src$",
                  recursive = TRUE, full.names = TRUE, include.dirs = TRUE), 
       recursive = TRUE)
pak_cleanup(force = TRUE)
EOF

    Rscript $APPTAINER_TMPDIR/install_r.R

    # --------------------------------------------------------------------------
    # 4b. R packages needing source patching (maptools, archived on CRAN)
    # --------------------------------------------------------------------------
    mkdir -p ~/.R
    MAKEVARS_FILE=~/.R/Makevars

    # Ensure the format-security flag is ignored to prevent compilation errors
    if [ ! -f "$MAKEVARS_FILE" ]; then
        touch "$MAKEVARS_FILE"
    fi

    if ! grep -q "Wno-error=format-security" "$MAKEVARS_FILE"; then
        echo "CFLAGS += -Wno-error=format-security" >> "$MAKEVARS_FILE"
    fi

    cd $TMPDIR
    wget -qO maptools_1.1-8.tar.gz https://cran.r-project.org/src/contrib/Archive/maptools/maptools_1.1-8.tar.gz

    tar -xzf maptools_1.1-8.tar.gz

    # Replace R-specific Calloc/Free with standard C calloc/free
    sed -i 's/Calloc(pol.lines, PLOT_POINT)/calloc(pol.lines, sizeof(PLOT_POINT))/g' maptools/src/pip.c
    sed -i 's/Free(pol.p)/free(pol.p)/g' maptools/src/pip.c

    # Inject stdlib.h for standard C memory functions at the top of the file
    sed -i '1i #include <stdlib.h>' maptools/src/pip.c

    rm -f maptools/MD5

    tar -czf maptools_1.1-8_patched.tar.gz maptools

    R CMD INSTALL maptools_1.1-8_patched.tar.gz

    rm -rf maptools maptools_1.1-8.tar.gz maptools_1.1-8_patched.tar.gz

    # --------------------------------------------------------------------------
    # 5. Perl
    # --------------------------------------------------------------------------
    apt-get install -qy --no-install-recommends \
      libconfig-inifiles-perl libconfig-ini-perl libtemplate-plugin-posix-perl \
      libscalar-list-utils-perl libwww-perl libdatetime-perl libstatistics-r-perl \
      cpanminus

    cpanm --force -q Strict::Perl LWP Cwd less Class::MOP


    # --------------------------------------------------------------------------
    # 6. Pipeline Installation & Cleanup
    # --------------------------------------------------------------------------
    git clone -q https://github.com/BioinfoIPBLN/reanalyzerGSE /reanalyzerGSE
    chmod +x /reanalyzerGSE/reanalyzerGSE.sh
    chmod +x /reanalyzerGSE/scripts/*
    chmod +x /reanalyzerGSE/external_software/miARma-seq/miARma
    rm -rf /reanalyzerGSE/test_data
    find /reanalyzerGSE -name ".git" -type d -exec rm -rf {} + 2>/dev/null || true

    # Strip Binaries (reduce size)
    find /usr/local/lib/R/site-library -name "*.so" -exec strip --strip-unneeded {} + 2>/dev/null || true
    find /usr/local/lib/python3.*/dist-packages -name "*.so" -exec strip --strip-unneeded {} + 2>/dev/null || true
    find /bin_external -type f -executable -exec strip --strip-unneeded {} + 2>/dev/null || true

    # Remove R documentation and sources
    rm -rf /usr/local/lib/R/site-library/*/help
    rm -rf /usr/local/lib/R/site-library/*/doc
    rm -rf /usr/local/lib/R/site-library/*/html

    # Remove Python cache
    find /usr/lib/python3* -name __pycache__ -type d -exec rm -rf {} + 2>/dev/null || true
    find /usr/local/lib/python3* -name __pycache__ -type d -exec rm -rf {} + 2>/dev/null || true
    find /usr/local/lib/python3* -name "*.pyc" -delete 2>/dev/null || true

    # Final 
    apt-get install -qy --no-install-recommends libgfortran5 libgomp1 libuv1
    apt-get autoremove -qy --purge
    apt-get clean

    # Cleanup
    rm -rf /root/.cpan 2>/dev/null || true
    rm -rf /root/.cache 2>/dev/null || true
    rm -rf /root/.npm 2>/dev/null || true


%environment
    export PATH="/bin_external/edirect:/bin_external:/bin_external/lib:/reanalyzerGSE:/reanalyzerGSE/scripts:/reanalyzerGSE/external_software/miARma-seq/:$PATH"
    export LC_ALL=en_US.UTF-8
    export LANG=en_US.UTF-8
    export LD_LIBRARY_PATH="/usr/lib/x86_64-linux-gnu:$LD_LIBRARY_PATH"

%runscript
    exec /reanalyzerGSE/reanalyzerGSE.sh "$@"
